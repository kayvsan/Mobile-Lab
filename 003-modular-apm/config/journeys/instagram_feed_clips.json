{
  "journey": {
    "id": "instagram_feed_clips",
    "name": "Instagram Feed to Clips Automation",
    "package": "com.instagram.android",
    "platform": "android",
    "details": [
      {
        "id": "launch",
        "name": "Launch Instagram",
        "measure_response_time": false,
        "tasks": [
          {
            "id": "open_app",
            "name": "Open Instagram",
            "type": "app_open",
            "timeout": 30,
            "measure_response_time": true,
            "critical": true
          }
        ]
      },
      {
        "id": "navigate_to_clips_tab",
        "name": "Navigate Feed \u00e2\u2020\u2019 Clips Tab",
        "measure_response_time": true,
        "tasks": [
          {
            "id": "tap_feed",
            "name": "Tap Feed Tab",
            "type": "within_ui",
            "find_by": "xpath",
            "content": "//*[@resource-id='com.instagram.android:id/feed_tab']",
            "element_name": "Feed Tab",
            "action": "tap",
            "timeout": 5,
            "measure_response_time": true,
            "critical": true
          },
          {
            "id": "tap_clips",
            "name": "Tap Clips/Reels Tab",
            "type": "within_ui",
            "find_by": "id",
            "content": "com.instagram.android:id/clips_tab",
            "element_name": "Clips/Reels Tab",
            "action": "tap",
            "timeout": 5,
            "measure_response_time": true,
            "critical": true
          }
        ]
      },
      {
        "id": "clips_screen_interaction",
        "name": "Interact with Clips Screen",
        "measure_response_time": true,
        "tasks": [
          {
            "id": "tap_center_button_1",
            "name": "Tap Center Screen (First)",
            "type": "tap_coords",
            "x": 540,
            "y": 679,
            "measure_response_time": true,
            "critical": true
          },
          {
            "id": "tap_center_button_2",
            "name": "Tap Center Screen (Second)",
            "type": "tap_coords",
            "x": 540,
            "y": 679,
            "measure_response_time": true,
            "critical": true
          }
        ]
      },
      {
        "id": "navigate_to_search",
        "name": "Navigate to Search",
        "measure_response_time": true,
        "tasks": [
          {
            "id": "tap_search_icon",
            "name": "Tap Search Icon",
            "type": "within_ui",
            "find_by": "xpath",
            "content": "//*[@resource-id='com.instagram.android:id/search_tab']",
            "element_name": "Search Tab",
            "action": "tap",
            "timeout": 5,
            "measure_response_time": true,
            "critical": true
          },
          {
            "id": "tap_search",
            "name": "Tap Search Field",
            "type": "tap_coords",
            "x": 355,
            "y": 198,
            "measure_response_time": true,
            "critical": true
          },
          {
            "id": "type_blindly",
            "name": "Type into focused field",
            "type": "ui",
            "action": "input",
            "input": "hello world",
            "handler": "system",
            "measure_response_time": true
          }
        ]
      },
      {
        "id": "return_to_clips",
        "name": "Return to Clips View",
        "measure_response_time": true,
        "tasks": [
          {
            "id": "back_to_feed",
            "name": "Back Until Clips Tab Visible",
            "type": "back_until_ui",
            "find_by": "xpath",
            "content": "//*[@resource-id='com.instagram.android:id/clips_tab']",
            "element_name": "Clips Tab Indicator",
            "action": "none",
            "max_presses": 3,
            "timeout": 20,
            "measure_response_time": true,
            "critical": false
          },
          {
            "id": "tap_clips_if",
            "name": "Ensure Clips Tab Selected",
            "type": "do_if_ui",
            "element_name": "Icon clips",
            "content": "//*[@resource-id='com.instagram.android:id/clips_tab']",
            "action": "tap",
            "timeout": 5,
            "measure_response_time": true,
            "critical": false
          },
          {
            "id": "dismiss_popups",
            "name": "Dismiss 'Not Now' Popups",
            "type": "do_while_ui",
            "element_name": "Not Now Button",
            "content": "//*[contains(@text, 'Not Now')]",
            "action": "tap",
            "timeout": 15,
            "measure_response_time": true,
            "critical": false
          }
        ]
      },
      {
        "id": "scroll_loop_1",
        "name": "Scroll Feed (1-3)",
        "measure_response_time": false,
        "tasks": [
          {
            "id": "scroll_1",
            "name": "Scroll #1",
            "type": "scroll_with_timing",
            "direction": "up",
            "scale": 0.6,
            "wait_after": 1.5,
            "measure_response_time": true,
            "critical": false
          },
          {
            "id": "scroll_2",
            "name": "Scroll #2",
            "type": "scroll_with_timing",
            "direction": "up",
            "scale": 0.6,
            "wait_after": 1.5,
            "measure_response_time": true,
            "critical": false
          },
          {
            "id": "scroll_3",
            "name": "Scroll #3",
            "type": "scroll_with_timing",
            "direction": "up",
            "scale": 0.6,
            "wait_after": 1.5,
            "measure_response_time": true,
            "critical": false
          }
        ]
      },
      {
        "id": "scroll_loop_2",
        "name": "Scroll Feed (4-5)",
        "measure_response_time": false,
        "tasks": [
          {
            "id": "scroll_4",
            "name": "Scroll #4",
            "type": "scroll_with_timing",
            "direction": "up",
            "scale": 0.6,
            "wait_after": 1.5,
            "measure_response_time": true,
            "critical": false
          },
          {
            "id": "scroll_5",
            "name": "Scroll #5",
            "type": "scroll_with_timing",
            "direction": "up",
            "scale": 0.6,
            "wait_after": 1.5,
            "measure_response_time": true,
            "critical": false
          }
        ]
      },
      {
        "id": "cleanup",
        "name": "Close App",
        "measure_response_time": true,
        "tasks": [
          {
            "id": "close_app",
            "name": "Stop Instagram",
            "type": "app_close",
            "timeout": 10,
            "wait": 1,
            "measure_response_time": true,
            "critical": false
          }
        ]
      }
    ]
  }
}