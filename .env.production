# ── Database Configuration ──
DB_NAME=apm_db
DB_USER=apm_user
# Ganti dengan password yang aman untuk database!
DB_PASSWORD=apm_secure_password_123!

# ── Backend Security ──
# Ganti dengan string acak (misal: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=b9c46522ef...GANTI_INI...42831b
WEBHOOK_API_KEY=apm-default-api-key

# ── App Port (host machine) ──
APP_PORT=80
